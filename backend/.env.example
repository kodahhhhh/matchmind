AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
ANALYST_MODEL=gpt-6.1-sol
BULK_MODEL=gpt-6-luna
# embeddings: azure (deployment name) or cloudflare (Workers AI model id)
EMBED_PROVIDER=cloudflare
EMBED_DEPLOYMENT=@cf/qwen/qwen3-embedding-0.6b
EMBED_DIM=1024
EMBED_QUERY_INSTRUCTION="Instruct: Given a football search query, retrieve live commentary lines describing matching moments\nQuery: "
CF_ACCOUNT_ID=
CF_AI_API_TOKEN=
DATABASE_URL=postgresql://matchmind:matchmind@localhost:5432/matchmind
# Required when running in a worktree; default elsewhere is <repo>/data.
DATA_DIR=/home/ubuntu/hackathon/data
